{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "sin1"
  ],
  "installCommand": "npm ci",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "web-dist",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "{cloud/**,indexer/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/refresh",
      "destination": "/api/refresh"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/methodology",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
